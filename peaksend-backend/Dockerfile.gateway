## 第一阶段，编译网关模块
FROM maven:3.9.9-eclipse-temurin-8 AS builder

WORKDIR /build

RUN apt-get update \
    && apt-get install -y openjdk-17-jdk \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

COPY pom.xml ./
COPY sky-common/pom.xml sky-common/pom.xml
COPY sky-pojo/pom.xml sky-pojo/pom.xml
COPY sky-server/pom.xml sky-server/pom.xml
COPY sky-gateway/pom.xml sky-gateway/pom.xml

COPY sky-gateway/src sky-gateway/src

RUN mvn -pl sky-gateway -am clean package -DskipTests

## 第二阶段，运行网关
FROM eclipse-temurin:8-jre
WORKDIR /app

RUN apt-get update \
    && apt-get install -y openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

COPY --from=builder /build/sky-gateway/target/sky-gateway-1.0-SNAPSHOT.jar app.jar

EXPOSE 8082

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
