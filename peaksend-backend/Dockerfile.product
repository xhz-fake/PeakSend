FROM maven:3.9.9-eclipse-temurin-8 AS builder

WORKDIR /build

RUN apt-get update \
    && apt-get install -y openjdk-17-jdk \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

COPY .mvn/settings.xml .mvn/settings.xml
COPY pom.xml ./
COPY sky-common/pom.xml sky-common/pom.xml
COPY sky-pojo/pom.xml sky-pojo/pom.xml
COPY sky-server/pom.xml sky-server/pom.xml
COPY sky-gateway/pom.xml sky-gateway/pom.xml
COPY product-service/pom.xml product-service/pom.xml

COPY sky-common/src sky-common/src
COPY sky-pojo/src sky-pojo/src
COPY product-service/src product-service/src

RUN mvn -s .mvn/settings.xml -pl product-service -am clean package -DskipTests

FROM eclipse-temurin:8-jre
WORKDIR /app

RUN apt-get update \
    && apt-get install -y openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

COPY --from=builder /build/product-service/target/product-service-1.0-SNAPSHOT.jar app.jar

EXPOSE 8083

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
